{
  "name": "workout-planner",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "db:migrate": "node scripts/run-sql.cjs db/migrations/001_initial_schema.sql",
    "db:seed": "node scripts/run-sql.cjs db/seeds/exercises.sql",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:test:create": "node scripts/create-test-database.cjs",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --configLoader native tests/exercise.routes.test.ts",
    "test:coverage": "vitest run --configLoader native --coverage",
    "test:integration": "vitest run --configLoader native tests/integration",
    "test:watch": "vitest --configLoader native",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Areco892/Workout-Planner.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Areco892/Workout-Planner/issues"
  },
  "homepage": "https://github.com/Areco892/Workout-Planner#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "config": "^4.2.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/config": "^3.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.2.1",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
